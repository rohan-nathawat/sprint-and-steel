  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  npcName: Mayor
  portraitColor: {r: 0.85098046, g: 0.854902, b: 0.63529414, a: 1}
  promptHeight: 1.35
  promptColor: {r: 0.93, g: 0.94, b: 0.95, a: 1}
