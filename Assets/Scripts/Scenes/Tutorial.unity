  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1bdf39a4b398b1b42b669c26c54f07b4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CinematicText
  cinematicLabel: {fileID: 1920510954}
  lines:
  - text: You can use [L-SHIFT] to sprint quickly. However, you will need to make
      sure your sprint meter is filled up to do so.
    delayBeforeFade: 0.5
    fadeInDuration: 1
    holdDuration: 4
    fadeOutDuration: 1
  - text: This training ground will teach you everything you need to protect us.
      Start by using [WASD] to move.
    delayBeforeFade: 0.8
    fadeInDuration: 1.5
    holdDuration: 4
    fadeOutDuration: 1.2
  - text: An enemy is approaching. Use [SPACE] to attack in the direction you are
      facing.
    delayBeforeFade: 0.5
    fadeInDuration: 1
    holdDuration: 3
    fadeOutDuration: 1
  - text: There are many types of enemies with varying amounts of health. You can
      sprint into enemies using [SHIFT] to clear them instantly.
    delayBeforeFade: 0.5
    fadeInDuration: 1
    holdDuration: 4.5
    fadeOutDuration: 1
  - text: 'You are now ready to begin. Use your new hunting skills to help our village
      people. '
    delayBeforeFade: 0.5
    fadeInDuration: 1
    holdDuration: 3.6
    fadeOutDuration: 1
  hudsToHide:
  - {fileID: 1897485650}
